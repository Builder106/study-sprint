{
  "name": "studysprint",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "comment": "Mirror of deno.json#imports \u2014 kept in sync so Vercel (Node-only build env) can resolve and bundle the SPA. Local dev still goes through `deno task dev`. When adding/upgrading a dep, edit deno.json first then mirror the change here.",
  "overrides": {
    "playwright": "1.64.1"
  },
  "scripts": {
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "node ./node_modules/playwright-bdd/dist/cli/index.js --config=playwright.config.ts && node ./node_modules/@playwright/test/cli.js test --config=playwright.config.ts",
    "tour": "DEMO=1 bddgen --config=playwright.tour.config.ts && DEMO=1 playwright test --config=playwright.tour.config.ts",
    "tour:light": "DEMO=1 DEMO_THEME=light bddgen --config=playwright.tour.config.ts && DEMO=1 DEMO_THEME=light playwright test --config=playwright.tour.config.ts",
    "verify:a11y-matrix": "node --experimental-strip-types scripts/verify-a11y-matrix.ts",
    "test:accessibility": "playwright test --config=playwright.accessibility.config.ts"
  },
  "dependencies": {
